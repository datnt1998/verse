# Build context hygiene for the hosted images (context = repository root).
# The web stage builds dist from source; the Go stage embeds it.

# VCS / editors / agents
.git
.github
.vscode
.idea
.agentkit
.omp
**/.DS_Store

# Local config, keys, credentials, run logs
**/.env
**/.env.*
**/.ainovel
*.log
**/*.pem
**/*.key

# GoReleaser output at the repository root
dist

# Noverse host-only artifacts and homes
apps/noverse/config
apps/noverse/ainovel-cli
apps/noverse/workspace
apps/noverse/dist
apps/noverse/tasks
apps/noverse/refer
apps/noverse/output*

# Node deps and CI caches: the web stage runs `npm ci` from the lockfile
**/node_modules
**/.vite
**/coverage
**/playwright-report
**/test-results

# Generated SPA output: rebuilt inside the image, never taken from the host
apps/noverse/internal/entry/web/dist

# Python/Go local caches (Go modules come from the proxy, not the context)
**/__pycache__
**/.pytest_cache
**/testdata
