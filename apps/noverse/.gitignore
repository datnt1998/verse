# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# 项目级配置 dotdir（镜像 ~/.ainovel/）：config.json 含密钥，rules/ 为本地写作偏好
.ainovel/

# storage-contract fixtures must keep their .ainovel dirs (phase-01 contract tests)
!internal/store/testdata/storage-contract/**/.ainovel
!internal/store/testdata/storage-contract/**/.ainovel/**

# Editor/IDE
.idea/
.vscode/
.cache
.DS_Store

# GoReleaser artifacts
dist/
release-notes.md
/ainovel-cli

tasks
refer/
output*
/workspace/
novels/
config/config.json
config/models-cache.json
*.log
logs/
config/
scratch/
config-laptop/
workspace-laptop/

# Web dependencies; keep embedded production assets tracked.
/web/node_modules/
!/internal/entry/web/dist/
!/internal/entry/web/dist/**

# Root-level vite/vitest caches
/node_modules/
*.tsbuildinfo

# storage-contract fixtures: keep .ainovel/ and output/ trees tracked (phase-01)
!internal/store/testdata/storage-contract/**/output
!internal/store/testdata/storage-contract/**/output/**

# npm pack output
web/packages/ui/*.tgz
