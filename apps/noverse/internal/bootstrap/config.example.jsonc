{
  // Provider và Model mặc định sử dụng.
  // ★ Giá trị "provider" là một con trỏ (pointer) trỏ tới một key trong danh sách "providers" bên dưới.
  //   Trong TUI, bạn có thể dùng lệnh /config để quản lý Provider/Model và /model để chuyển đổi nhanh.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",

  // (Tùy chọn) Mức độ suy luận (reasoning effort): off / low / medium / high / xhigh / max.
  // Bỏ trống hoặc không khai báo = giữ nguyên mặc định của mô hình/nhà cung cấp.
  "reasoning_effort": "medium",

  // Danh mục cấu hình nhà cung cấp AI (Provider).
  // Các provider được hỗ trợ sẵn: openai, anthropic, gemini, openrouter, opencode-go, deepseek, qwen, glm, grok, mimo, ollama, bedrock, openai-codex, xai-oauth, anthropic-oauth.
  // Đối với proxy tùy chỉnh, bạn cần chỉ định thêm trường "type" (openai/anthropic/gemini/openai-codex/xai-oauth/anthropic-oauth).
  // Khi mở truyện, chỉ nhà cung cấp mặc định, theo vai và dự phòng được kiểm để bật viết.
  // Mục chưa dùng bị sai vẫn hiện cảnh báo tại Tuỳ chỉnh › Kết nối AI; lưu cấu hình sẽ từ chối mục sai.
  "providers": {
    // 1. Ollama Cục bộ (Chạy offline trên máy tính, hoàn toàn miễn phí)
    "ollama": {
      // Khi chạy trực tiếp từ máy: "http://localhost:11434/v1"
      // Khi chạy qua Docker trên Windows/macOS: "http://host.docker.internal:11434/v1"
      // Lưu ý: Endpoint OpenAI-compatible của Ollama bắt buộc phải có đuôi /v1
      "base_url": "http://localhost:11434/v1",
      // Không bắt buộc phải có api_key đối với Ollama
      "models": [
        { "name": "qwen2.5:14b", "context_window": 65536 },
        { "name": "ainovel-qwen", "context_window": 65536 }
      ],
      // Thời gian chờ stream rảnh rỗi (Go duration, mặc định "5m"):
      // Với mô hình local chạy trên máy cấu hình vừa phải, có thể đặt "15m" để không bị timeout khi suy luận dài.
      "stream_idle_timeout": "15m"
    },

    // 2. OpenRouter (Truy cập hầu hết các mô hình Claude, Gemini, DeepSeek, Qwen qua 1 API key)
    "openrouter": {
      "api_key": "sk-or-v1-YOUR_OPENROUTER_KEY",
      "base_url": "https://openrouter.ai/api/v1",
      "models": [
        { "name": "google/gemini-2.5-flash", "context_window": 200000 },
        { "name": "google/gemini-2.5-pro", "context_window": 1000000 },
        { "name": "anthropic/claude-3.5-sonnet", "context_window": 200000 },
        { "name": "deepseek/deepseek-chat", "context_window": 64000 }
      ],
      // (Tùy chọn) Tham số bổ sung gửi kèm theo mỗi request (temperature, top_p, min_p...)
      "extra_body": { "temperature": 0.8, "min_p": 0.05 }
    },

    // 2a. OpenCode Go (gói thuê bao, dùng API key lấy ở https://opencode.ai/auth)
    // Một khoá dùng được Kimi, DeepSeek, GLM, Qwen, MiniMax, MiMo… qua cùng endpoint.
    // Danh sách model hiện hành: GET https://opencode.ai/inference/go/v1/models
    "opencode-go": {
      "api_key": "YOUR_OPENCODE_API_KEY",
      "base_url": "https://opencode.ai/inference/go/v1",
      "models": [
        { "name": "kimi-k2.7-code", "context_window": 262144 },
        { "name": "deepseek-v4.1-flash", "context_window": 1000000 },
        { "name": "glm-5.3", "context_window": 1000000 }
      ]
    },

    // 2b. ChatGPT Plus/Pro (Codex Subscription) — dùng hạn mức gói ChatGPT, không cần api_key.
    // Đăng nhập trước: `ainovel-cli login` (SSH/headless: `ainovel-cli login --device`).
    // Credential lưu ở ~/.ainovel/auth.json và tự làm mới. Xem model khả dụng: `ainovel-cli login --status`.
    // Backend Codex không nhận temperature/top_p/max tokens: các tham số này bị tự động bỏ qua.
    // Codex luôn dùng Responses (kể cả type: "openai-codex" với tên tuỳ chỉnh).
    // "api": "responses" từ cấu hình cũ vẫn hợp lệ; web bỏ trường thừa này khi lưu. Giá trị khác bị từ chối.
    "openai-codex": {
      "models": [
        { "name": "gpt-5.6-terra", "context_window": 272000 }
      ]
    },

    // 2c. SuperGrok / X Premium+ (xAI) — dùng hạn mức gói thuê bao xAI, không cần api_key.
    // Đăng nhập trước: `ainovel-cli login xai-oauth` (luôn dùng mã thiết bị: mở link bất kỳ máy nào rồi nhập mã).
    // Credential lưu ở ~/.ainovel/auth.json và tự làm mới. Xem model khả dụng: `ainovel-cli login --status`.
    // Nếu xAI trả 403 sau khi đăng nhập: gói của bạn chưa có quyền API qua OAuth — hãy dùng provider "grok" với API key.
    // Đây là provider khác với "grok" (API key trả phí): không cần api_key, không cấu hình "api"; base_url nếu đặt phải là https trên miền x.ai.
    "xai-oauth": {
      "models": [
        // Model không có trong bảng giá nội bộ sẽ tạm tính cửa sổ 200000: thêm "context_window" nếu biết cửa sổ thực.
        { "name": "grok-4.6" },
        { "name": "grok-4.3" }
      ]
    },

    // 2d. Claude Pro/Max (Anthropic) — dùng hạn mức gói thuê bao Claude, không cần api_key.
    // Đăng nhập trước: `ainovel-cli login anthropic-oauth` (trình duyệt mở trên chính máy này; SSH/headless: thêm `--device`,
    // mở link ở máy bất kỳ rồi dán mã `code#state` hoặc URL chuyển hướng vào terminal). Trên web: Tuỳ chỉnh › Nhà cung cấp AI.
    // Credential lưu ở ~/.ainovel/auth.json và tự làm mới. Xem model khả dụng: `ainovel-cli login --status`.
    // Đây là provider khác với "anthropic" (API key trả phí): không cần api_key, không cấu hình "api"; base_url nếu đặt phải là https trên miền anthropic.com.
    // Request mang dấu vân tay Claude Code theo cách omp (oh-my-pi) làm; 403 = gói chưa có quyền API qua OAuth, 429 = chạm hạn mức gói.
    "anthropic-oauth": {
      "models": [
        { "name": "claude-sonnet-4-6", "context_window": 200000 },
        { "name": "claude-opus-4-8", "context_window": 200000 },
        { "name": "claude-haiku-4-5", "context_window": 200000 }
      ]
    },

    // 3. Anthropic Claude chính hãng
    "anthropic": {
      "api_key": "sk-ant-YOUR_ANTHROPIC_KEY",
      "models": [
        { "name": "claude-3-5-sonnet-20241022", "context_window": 200000, "json_schema": true }
      ]
    },

    // 4. Google Gemini chính hãng
    "gemini": {
      "api_key": "YOUR_GEMINI_API_KEY",
      "models": [
        { "name": "gemini-2.5-flash", "context_window": 200000 },
        { "name": "gemini-2.5-pro", "context_window": 1000000 }
      ]
    },

    // 5. DeepSeek API chính hãng
    "deepseek": {
      "api_key": "sk-YOUR_DEEPSEEK_KEY",
      "models": [
        { "name": "deepseek-chat", "context_window": 64000 },
        { "name": "deepseek-reasoner", "context_window": 64000 }
      ]
    },

    // 6. OpenAI chính hãng
    "openai": {
      "api_key": "sk-YOUR_OPENAI_KEY",
      "models": [
        { "name": "gpt-4o", "context_window": 128000 },
        { "name": "gpt-4o-mini", "context_window": 128000 }
      ]
    }
  },

  // (Tùy chọn) Cấu hình phân vai mô hình (Multi-Agent Role Mapping).
  // Các vai trò:
  // - "architect": Kiến trúc sư (Lên dàn ý, phân cảnh, thế giới, nhân vật)
  // - "writer": Người viết (Chấp bút chi tiết từng chương)
  // - "editor": Biên tập viên (Đánh giá, phản biện, kiểm tra chất lượng)
  // "roles": {
  //   "architect": { "provider": "openrouter", "model": "google/gemini-2.5-pro" },
  //   "editor": { "provider": "openrouter", "model": "google/gemini-2.5-pro" },
  //   "writer": {
  //     "provider": "ollama",
  //     "model": "ainovel-qwen",
  //     "fallbacks": [{ "provider": "openrouter", "model": "deepseek/deepseek-chat" }]
  //   }
  // },

  // Phong cách sáng tác mặc định: "default" / "fantasy" / "romance" / "suspense"
  "style": "default"

  // (Tùy chọn) Cửa sổ ngữ cảnh toàn cục phiên bản cũ (fallback nếu không cấu hình trong models).
  // "context_window": 65536,

  // (Tùy chọn) Hạn mức ngân sách tối đa cho một cuốn sách (tính bằng USD).
  // "budget": {
  //   "book_usd": 10.0,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // (Tùy chọn) Thông báo hệ thống khi hoàn thành hoặc có sự cố.
  // "notify": {
  //   "enabled": true,
  //   // Unix: $NOTIFY_TITLE; Windows PowerShell: $env:NOTIFY_TITLE
  //   // "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish",
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }

  // (Tùy chọn) Bộ đọc trên máy cho Audio truyện (voice.TTSConfig). Kế thừa 3 cấp
  // như mọi khoá khác; api_key chỉ nên đặt ở cấu hình toàn cục.
  // "tts": {
  //   "engine": "vieneu",              // vieneu (mặc định, cài bằng `voice install`) | openai-speech
  //   "model": "vieneu-v3-turbo",     // model gửi lên máy đọc
  //   "device": "cpu",                // cpu | gpu
  //   "quality": "standard",          // fast | standard | high (mặc định của truyện)
  //   "endpoint": "",                 // engine openai-speech: vd http://127.0.0.1:8000
  //   "api_key": ""                   // Bearer token của máy chủ đó
  // }
}
