{
  "name": "@noverse/ui",
  "version": "0.1.0",
  "description": "Noverse UI kit — design tokens, primitives, icons, motion and a11y helpers.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.stylex": {
      "types": "./dist/tokens.stylex.d.ts",
      "default": "./dist/tokens.stylex.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./kit.css": "./src/kit.css",
    "./Toast.css": "./src/Toast.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json",
    "./brand": {
      "types": "./dist/brand.d.ts",
      "default": "./dist/brand.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens.css",
    "tokens.json",
    "src/kit.css",
    "src/Toast.css",
    "src/icons",
    "README.md",
    "scripts/brand.mjs",
    "scripts/brand-roles.mjs"
  ],
  "scripts": {
    "gen": "node scripts/gen-tokens.mjs && node scripts/gen-icons.mjs",
    "build": "npm run gen && vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:smoke": "node scripts/smoke-consumer.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  },
  "peerDependencies": {
    "@stylexjs/stylex": ">=0.10",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "bin": {
    "noverse-ui": "scripts/brand.mjs"
  }
}
