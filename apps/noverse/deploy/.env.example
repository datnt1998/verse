# Environment reference for the hosted (Dokploy) deployment.
#
# Copy to .env for the local compose mirror, or paste the keys into the
# Dokploy application's Environment tab (secrets belong there, never in the
# image or in a committed file). Every key here is read by the binary or the
# local compose file; nothing aspirational is listed.

# ── Facts backend ────────────────────────────────────────────────────────────
# file|postgres. STORE_DRIVER alone selects the complete fact + account
# backend (there is no second account selector). Hosted must be postgres;
# there is no silent fallback either direction.
STORE_DRIVER=postgres
# Application role: DML only, no DDL or DELETE on blobs/export_cache/history.
# Percent-encode reserved characters (quotes, @, :, /, %, #, ?) exactly as the
# platform prints them — a DSN is a URI, so the password is encoded in userinfo.
DATABASE_URL=postgres://noverse_app:CHANGE_ME@postgres:5432/noverse?sslmode=disable
# Maintenance role: owns the schema; used by migration, storage gc and audit
# retention jobs. storage gc REQUIRES this DSN (never falls back to DATABASE_URL).
# Leave empty in the app service: only maintenance jobs receive this secret.
MIGRATION_DATABASE_URL=postgres://noverse_migrate:CHANGE_ME@postgres:5432/noverse?sslmode=disable
# Pool bound for a single small VPS: integer 1..100 (default 8).
# Connect timeout: 1s..2m (default 10s). A value outside the range, or a
# partially numeric one ("8 conns"), fails startup — never silently clamped.
DB_MAX_CONNS=8
DB_CONNECT_TIMEOUT=10s

# ── BlobStore ────────────────────────────────────────────────────────────────
# local|s3 — independent of STORE_DRIVER.
STORAGE_DRIVER=s3
# dev|staging|prod. The first segment of every blob object key, of the pg
# backup keys and of the `storage gc` scope: one bucket can host several
# environments, and GC/lifecycle rules never cross the prefix. Empty means dev
# for the app and `storage gc`, but deploy/backup.sh requires it explicitly
# (no default: a guess would write backups into the wrong prefix). Any other
# value fails closed; set it on every hosted deployment.
STORAGE_ENV=prod
# local driver: absolute root, owned by the non-root container user.
BLOB_LOCAL_ROOT=/var/lib/noverse/blobs
# s3 driver (AWS S3 / Cloudflare R2 / GCS XML interop / Garage):
#   AWS            S3_ENDPOINT empty, S3_REGION=<bucket region>, path style false
#   Cloudflare R2  S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
#                  S3_REGION=auto, path style false
#   GCS            S3_ENDPOINT=https://storage.googleapis.com,
#                  S3_REGION=us-east-1, path style true, HMAC keys
#   Garage v2.5.0  private HTTP, region garage, path style true.
# MinIO is discontinued; the bundled/test S3 provider is Garage.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=noverse
# Generate: access ID = GK$(openssl rand -hex 12), secret = openssl rand -hex 32.
# Set real values in the runtime env; never commit them.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Private HTTP only; external public providers must use HTTPS and false.
S3_ALLOW_INSECURE_ENDPOINT=true
# Garage only: openssl rand -hex 32 for each; never commit generated values.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Provider preset shown in Tuỳ chỉnh › Lưu trữ tệp: garage|r2|aws|gcs|wasabi|b2|spaces|other.
S3_PROVIDER=garage
# How browsers receive media: redirect (307 to a short presigned GET; bucket
# needs a browser-reachable address + CORS) or proxy (the app streams with
# Range/ETag; no CORS, bucket stays private-network only). Empty = proxy for a
# private/http endpoint (Garage on the internal network), redirect otherwise.
BLOB_DELIVERY=proxy
# redirect only, when S3_ENDPOINT is internal: the bucket address browsers see
# (e.g. https://s3.example.com). Presigned URLs are signed for this host.
S3_PRESIGN_ENDPOINT=

# Any STORAGE_DRIVER/BLOB_*/S3_* variable above locks the storage settings UI:
# env wins entirely. Omit them all to configure storage from the app instead.
# Secrets saved from the app are AES-256-GCM encrypted with this key:
#   openssl rand -base64 32
# Leave the line OUT entirely (not empty) when unused: an empty or malformed
# value fails startup. Losing the key makes saved storage secrets unreadable.
# CONFIG_ENCRYPTION_KEY=

# Verified hosted audio source cache. Default root is $TMPDIR/ainovel-blob-cache;
# Dockerfile sets TMPDIR=/var/cache/noverse (mount a persistent scratch volume).
BLOB_CACHE_DIR=/var/cache/noverse/ainovel-blob-cache
# Cache byte budget (2 GiB, including derived peaks). Work/PCM/outputs need extra disk;
# this is not a total volume quota. Increase only with measured free space.
BLOB_CACHE_MAX_BYTES=2147483648
# R2 browser reads require bucket CORS for the exact PUBLIC_URL origin,
# GET/HEAD, Range + conditional headers; see deploy/README.md section 9.4.

# ── Server / proxy ───────────────────────────────────────────────────────────
# Bind inside the container. Never publish this port; Traefik is the only door.
HTTP_ADDR=0.0.0.0:8080
# Canonical public origin. Used for secure-cookie policy and accepted Origin.
PUBLIC_URL=https://noverse.example
# Comma-separated CIDRs of the proxy hop that is allowed to set
# X-Forwarded-For/X-Forwarded-Proto. Get the real source subnet with
#   docker network inspect <dokploy-network> -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# One name only (there is no alias), a wildcard (0.0.0.0/0) is rejected at
# startup, and the loopback-only rule applies when it is unset.
TRUSTED_PROXIES=172.16.0.0/12
# Required in hosted mode; startup fails unless PUBLIC_URL is https://.
SECURE_COOKIES=true
# Shared account store + shared session cookie (SSO with the sibling app on
# the same parent domain). Both require STORE_DRIVER=postgres; under the file
# backend they are a startup error.
# Cookie Domain for the shared `verse_session`: the registrable parent domain
# only (no scheme/port/IP/wildcard, never a public suffix). Startup fails
# unless it DNS-label-contains PUBLIC_URL's host and SECURE_COOKIES=true.
# Local SSO (no PUBLIC_URL) leaves this empty: the cookie is host-only and
# travels to every port on the host — never bind LAN/wildcard then.
VERSE_COOKIE_DOMAIN=
# Comma-separated absolute origins accepted for state-changing requests, in
# addition to own-origin: hosted = exact https origins under the cookie
# domain (e.g. the Viderse app); local = loopback origins only
# (http://127.0.0.1:<port>). Exact canonical match — no suffix, wildcard or
# scheme downgrade. An allowlisted origin gains NO business permission.
VERSE_APP_ORIGINS=
# Navigation links, NOT extra origin permissions. Both IDs are optional but
# unique; each origin must be own PUBLIC_URL or in VERSE_APP_ORIGINS above.
# Hosted values must remain https and inside VERSE_COOKIE_DOMAIN.
# VERSE_APP_LINKS=noverse=https://nov.example.com,viderse=https://vid.example.com
# Unset: current app only; no cross-app switcher.
VERSE_APP_LINKS=
# Dedicated DSN for engine-worker child processes: role noverse_engine_worker
# (deploy/postgres-init/03-engine-worker-role.sql), facts/lease tables only,
# never account tables. Hosted worker launch fails closed when unset — it
# never falls back to DATABASE_URL. Keep it out of the app DSN and logs.
NOVERSE_WORKER_DATABASE_URL=postgres://noverse_engine_worker:CHANGE_ME@postgres:5432/noverse?sslmode=disable

# ── Worker (Mac + Tailscale) ─────────────────────────────────────────────────
# App side: private listener bind. In Dokploy keep 0.0.0.0:8081 inside the
# container and publish only <TAILSCALE_IP>:8081 on the host.
WORKER_LISTEN_ADDR=0.0.0.0:8081
# Provision the device credential on the SERVER (STORE_DRIVER=postgres):
#   ainovel-cli worker token create --cap tts mac-mini   # prints the token once
#   ainovel-cli worker token list                        # no token ever printed
#   ainovel-cli worker token revoke <uuid|name>
# The schema allows exactly one capability today: tts.
# Mac side (do NOT set on the VPS app): the private URL and that one-time token.
# Never a DB or bucket secret.
#   TTS_WORKER_API_URL=http://<vps-tailscale-ip>:8081
#   TTS_WORKER_TOKEN=<one-time token>
#   ainovel-cli worker tts --api "$TTS_WORKER_API_URL" [--project <slug>] [--lease 120s]
# --api overrides TTS_WORKER_API_URL; --lease is a REQUEST the server clamps to
# 30s..10m (leases are server-authoritative so a dead Mac cannot pin a job).

# ── Local compose mirror only ────────────────────────────────────────────────
# These are consumed by deploy/docker-compose.dokploy.yml and
# deploy/dsn-entrypoint.sh, not by the binary's env contract.
# In Dokploy the platform provides Postgres and Traefik; only the values above
# are entered in the app's Environment tab.
#
# The mirror does NOT interpolate passwords into a DSN. deploy/postgres-init
# creates the roles from the raw POSTGRES_*_PASSWORD values (SQL-literal safe),
# then deploy/dsn-entrypoint.sh builds DATABASE_URL / MIGRATION_DATABASE_URL and
# percent-encodes every reserved character. Any generated password works,
# including quotes and @ : / % # ? — do not restrict the alphabet.
POSTGRES_DB=noverse
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-postgres-superuser
POSTGRES_MIGRATE_PASSWORD=local-migrate-password
POSTGRES_APP_PASSWORD=local-app-password
POSTGRES_WORKER_PASSWORD=local-worker-password
HTTPS_PORT=8443
HTTP_PORT=8080
WORKER_BIND_IP=127.0.0.1
PUBLIC_HOST=noverse.localhost

# ── Feature flags that are NOT env-configurable ──────────────────────────────
# Setup code TTL (30 min), login limiter windows, Argon2id parameters, session
# TTL, blob presign TTL and the job-lease envelope (30s..10m server clamp) are
# code constants. They are intentionally not environment knobs: a deployment
# cannot weaken them. A worker may ask for a lease, but the server clamps it.
