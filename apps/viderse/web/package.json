{
  "name": "viderse-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b src/editor/tsconfig.json && tsc --noEmit",
    "typecheck:engine": "tsc -b src/editor/tsconfig.json",
    "typecheck:engine-tests": "tsc --noEmit -p src/editor/tsconfig.test.json",
    "build:engine-worklet": "node scripts/build-editor-worklet.mjs",
    "build": "npm run typecheck && vite build",
    "test": "vitest run --pool=threads --maxWorkers=2",
    "test:engine": "vitest run --config vitest.editor.config.ts --pool=threads --maxWorkers=2",
    "test:node": "node --import tsx --test scripts/stylex-route-css.test.ts $(grep -rl --include='*.test.ts' \"from ['\\\"]node:test['\\\"]\" src/editor)",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lottiefiles/dotlottie-web": "0.76.0",
    "@mediabunny/aac-encoder": "1.50.8",
    "@mediabunny/ac3": "1.50.8",
    "@mediabunny/mp3-encoder": "1.50.8",
    "@mediabunny/prores": "1.50.8",
    "@noverse/ui": "*",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-virtual": "^3.14.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.2",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^1.66.0",
    "mediabunny": "1.50.8",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.16.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vitejs/plugin-react": "^5.1.0",
    "@webgpu/types": "^0.1.69",
    "browserslist": "^4.29.4",
    "esbuild": "0.28.2",
    "happy-dom": "^20.0.0",
    "jsdom": "^27.4.0",
    "lightningcss": "^1.32.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "unplugin": "^2.3.11",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
